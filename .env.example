# Full interpretation is LLM-core. Use disabled only for structural inventory and tests.
AUTOHARNESS_MODEL_PROVIDER=disabled
AUTOHARNESS_MODEL_NAME=

# Phase 2 route values. Route order/locality live in project config; environment variables
# supply values and secrets without silently authorizing destinations.
AUTOHARNESS_LOCAL_MODEL=
AUTOHARNESS_GROQ_MODEL=
AUTOHARNESS_HF_MODEL=

# Provider credentials are optional. Phase 2 may use several entries from an explicitly
# configured route; setting a credential alone does not authorize or select that provider.
GROQ_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=

# Generic OpenAI-compatible endpoint, including a local server.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Runtime defaults.
AUTOHARNESS_LOG_LEVEL=INFO
AUTOHARNESS_OUTPUT_FORMAT=human
AUTOHARNESS_TELEMETRY_ENABLED=false

# External evidence is opt-in and credit-budgeted.
AUTOHARNESS_WEB_EVIDENCE_ENABLED=false
AUTOHARNESS_TAVILY_MAX_CREDITS=3
# Optional non-secret application cache root; external evidence is stored below this directory.
AUTOHARNESS_CACHE_DIR=
