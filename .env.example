# Model assistance is optional. A read-only scan must work with no credentials.
AUTOHARNESS_MODEL_PROVIDER=disabled
AUTOHARNESS_MODEL_NAME=

# Enable one provider only when exercising model-assisted features.
GROQ_API_KEY=
HF_TOKEN=

# Generic OpenAI-compatible endpoint, including a local server.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Runtime defaults.
AUTOHARNESS_LOG_LEVEL=INFO
AUTOHARNESS_OUTPUT_FORMAT=human
AUTOHARNESS_TELEMETRY_ENABLED=false
